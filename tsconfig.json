{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@api/*": ["./api/*"],
      "@components": ["./components"],
      "@components/*": ["./components/*"],
      "@screens/*": ["./screens/*"],
      "@assets/*": ["./assets/*"],
      "@hooks/*": ["./hooks/*"],
      "@utils": ["./utils/index"],
      "@constants/*": ["./constants/*"],
      "@type/*": ["./types/*"],
      "@contexts/*": ["./contexts/*"],
      "@services/*": ["./api/services/*"],
      "@store/*": ["./store/*"],
      "@queries/*": ["./api/queries/*"],
    },
    "types": ["nativewind/types"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}